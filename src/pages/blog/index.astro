---
import MainLayout from '@/layouts/MainLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const categories = [...new Set(posts.map(p => p.data.category))];

function categorySlug(cat: string) {
  return cat.toLowerCase().replace(/\s+/g, '-').replace(/&/g, 'e');
}

const categoryImages: Record<string, string> = {
  'iPhone': '/images/blog/cat-iphone.svg',
  'Samsung': '/images/blog/cat-samsung.svg',
  'Tablet': '/images/blog/cat-tablet.svg',
  'PC & Mac': '/images/blog/cat-pc-mac.svg',
  'Console': '/images/blog/cat-console.svg',
  'Guide': '/images/blog/cat-guide.svg',
  'Le Nostre Riparazioni': '/images/blog/cat-riparazioni.svg',
  'Riparazioni': '/images/blog/cat-riparazioni-generico.svg',
};

function getPostImage(post: any) {
  return post.data.image || categoryImages[post.data.category] || '/images/blog/cat-guide.svg';
}

function getPostImageAlt(post: any) {
  return post.data.imageAlt || `${post.data.title} - Giolab Riparazioni Assemini`;
}

const jsonLdBreadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://giolabriparazioni.it/' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://giolabriparazioni.it/blog' },
  ],
};
---

<MainLayout
  title="Blog | Guide e Consigli Riparazione Smartphone e PC | Giolab"
  description="Consigli pratici e guide per la cura dei tuoi dispositivi. Riparazione smartphone, PC e console: tutto quello che devi sapere, dal tecnico di Giolab Assemini."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdBreadcrumb)} />
  </Fragment>

  <!-- Hero -->
  <section class="bg-gradient-to-br from-giolab-blue to-giolab-blue-dark text-white">
    <div class="section-padding text-center">
      <nav class="text-sm text-blue-200 mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white">Home</a>
        <span class="mx-2">/</span>
        <span class="text-white">Blog</span>
      </nav>
      <h1 class="text-4xl md:text-5xl font-extrabold !text-white mb-4">Il Blog di Giolab</h1>
      <p class="text-lg text-blue-100 max-w-2xl mx-auto">Guide, consigli e novità dal mondo delle riparazioni elettroniche.</p>
    </div>
  </section>

  <!-- Category Filter -->
  {categories.length > 0 && (
    <section class="border-b border-gray-200">
      <div class="max-w-7xl mx-auto px-4 py-4 flex gap-2 overflow-x-auto">
        <a href="/blog" class="px-4 py-2 rounded-full text-sm font-medium bg-giolab-blue text-white whitespace-nowrap">Tutti</a>
        {categories.map(cat => (
          <a href={`/blog/categoria/${categorySlug(cat)}`} class="px-4 py-2 rounded-full text-sm font-medium bg-gray-100 text-gray-600 hover:bg-gray-200 transition-colors whitespace-nowrap">{cat}</a>
        ))}
      </div>
    </section>
  )}

  <!-- Posts Grid -->
  <section>
    <div class="section-padding">
      {posts.length === 0 ? (
        <div class="text-center py-16">
          <svg class="w-16 h-16 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          <h2 class="text-2xl font-bold mb-2">Nessun articolo ancora</h2>
          <p class="text-gray-600">Stiamo lavorando ai prossimi contenuti. Torna presto!</p>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {posts.map(post => (
            <article class="group relative bg-white rounded-xl shadow-md hover:shadow-xl transition-all duration-300 hover:-translate-y-1 flex flex-col overflow-hidden">
              {/* Image / Placeholder with category badge */}
              <a href={`/blog/${post.id}`} class="relative block h-48 overflow-hidden">
                <img
                  src={getPostImage(post)}
                  alt={getPostImageAlt(post)}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                  width="400"
                  height="200"
                />
                {/* Category Badge */}
                <span class:list={[
                  'absolute top-3 left-3 text-xs font-semibold px-3 py-1 rounded-full shadow-sm',
                  post.data.category === 'Le Nostre Riparazioni'
                    ? 'bg-giolab-orange text-white'
                    : 'bg-white text-giolab-blue',
                ]}>
                  {post.data.category}
                </span>
                {/* Difficulty badge for case studies */}
                {post.data.difficulty && (
                  <span class:list={[
                    'absolute top-3 right-3 text-xs font-semibold px-2.5 py-1 rounded-full',
                    post.data.difficulty === 'Bassa' ? 'bg-green-500 text-white' :
                    post.data.difficulty === 'Media' ? 'bg-yellow-500 text-white' :
                    'bg-red-500 text-white',
                  ]}>
                    {post.data.difficulty}
                  </span>
                )}
                {/* Hover overlay */}
                <div class="absolute inset-0 bg-giolab-blue/0 group-hover:bg-giolab-blue/10 transition-colors duration-300"></div>
              </a>
              {/* Content */}
              <div class="p-5 flex flex-col flex-1">
                <div class="flex items-center gap-3 mb-2 text-xs text-gray-500">
                  <time datetime={post.data.date.toISOString()}>
                    {post.data.date.toLocaleDateString('it-IT', { year: 'numeric', month: 'long', day: 'numeric' })}
                  </time>
                  {post.data.readingTime && (
                    <>
                      <span>&middot;</span>
                      <span>{post.data.readingTime}</span>
                    </>
                  )}
                </div>
                <h2 class="text-lg font-bold mb-2 group-hover:text-giolab-blue transition-colors leading-snug">
                  <a href={`/blog/${post.id}`}>{post.data.title}</a>
                </h2>
                <p class="text-sm text-gray-600 mb-4 flex-1 line-clamp-3">{post.data.description}</p>
                <a href={`/blog/${post.id}`} class="text-sm text-giolab-blue font-semibold hover:underline inline-flex items-center gap-1 mt-auto">
                  Leggi l'articolo
                  <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                </a>
              </div>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>
</MainLayout>
