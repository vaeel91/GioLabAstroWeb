---
import MainLayout from '@/layouts/MainLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const categories = [...new Set(posts.map(p => p.data.category))];

const jsonLdBreadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://giolabriparazioni.it/' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://giolabriparazioni.it/blog' },
  ],
};
---

<MainLayout
  title="Blog"
  description="Consigli, guide e novità dal mondo delle riparazioni. Scopri come prenderti cura dei tuoi dispositivi elettronici con i consigli di Giolab."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdBreadcrumb)} />
  </Fragment>

  <!-- Hero -->
  <section class="bg-gradient-to-br from-giolab-blue to-giolab-blue-dark text-white">
    <div class="section-padding text-center">
      <nav class="text-sm text-blue-200 mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white">Home</a>
        <span class="mx-2">/</span>
        <span class="text-white">Blog</span>
      </nav>
      <h1 class="text-4xl md:text-5xl font-extrabold !text-white mb-4">Il Blog di Giolab</h1>
      <p class="text-lg text-blue-100 max-w-2xl mx-auto">Guide, consigli e novità dal mondo delle riparazioni elettroniche.</p>
    </div>
  </section>

  <!-- Category Filter -->
  {categories.length > 0 && (
    <section class="border-b border-gray-200">
      <div class="max-w-7xl mx-auto px-4 py-4 flex gap-2 overflow-x-auto">
        <a href="/blog" class="px-4 py-2 rounded-full text-sm font-medium bg-giolab-blue text-white whitespace-nowrap">Tutti</a>
        {categories.map(cat => (
          <span class="px-4 py-2 rounded-full text-sm font-medium bg-gray-100 text-gray-600 hover:bg-gray-200 transition-colors whitespace-nowrap cursor-pointer">{cat}</span>
        ))}
      </div>
    </section>
  )}

  <!-- Posts Grid -->
  <section>
    <div class="section-padding">
      {posts.length === 0 ? (
        <div class="text-center py-16">
          <div class="text-6xl mb-4">📝</div>
          <h2 class="text-2xl font-bold mb-2">Nessun articolo ancora</h2>
          <p class="text-gray-600">Stiamo lavorando ai prossimi contenuti. Torna presto!</p>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {posts.map(post => (
            <article class="card group hover:-translate-y-1 transition-transform duration-300 flex flex-col">
              <div class="bg-giolab-gray rounded-lg h-48 flex items-center justify-center mb-4 overflow-hidden">
                <span class="text-5xl">📄</span>
              </div>
              <div class="flex items-center gap-3 mb-3">
                <span class="text-xs font-semibold bg-blue-50 text-giolab-blue px-3 py-1 rounded-full">{post.data.category}</span>
                {post.data.readingTime && (
                  <span class="text-xs text-gray-500">{post.data.readingTime}</span>
                )}
              </div>
              <h2 class="text-lg font-bold mb-2 group-hover:text-giolab-blue transition-colors">
                <a href={`/blog/${post.id}`} class="hover:underline">{post.data.title}</a>
              </h2>
              <p class="text-sm text-gray-600 mb-4 flex-1">{post.data.description}</p>
              <div class="flex items-center justify-between text-xs text-gray-500">
                <time datetime={post.data.date.toISOString()}>
                  {post.data.date.toLocaleDateString('it-IT', { year: 'numeric', month: 'long', day: 'numeric' })}
                </time>
                <a href={`/blog/${post.id}`} class="text-giolab-blue font-semibold hover:underline">Leggi &rarr;</a>
              </div>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>
</MainLayout>
