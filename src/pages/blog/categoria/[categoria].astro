---
import MainLayout from '@/layouts/MainLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog', ({ data }) => !data.draft);
  const categories = [...new Set(allPosts.map(p => p.data.category))];

  return categories.map(cat => ({
    params: { categoria: cat.toLowerCase().replace(/\s+/g, '-').replace(/&/g, 'e') },
    props: {
      category: cat,
      posts: allPosts
        .filter(p => p.data.category === cat)
        .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()),
    },
  }));
}

const { category, posts } = Astro.props;

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const categories = [...new Set(allPosts.map(p => p.data.category))];

function categorySlug(cat: string) {
  return cat.toLowerCase().replace(/\s+/g, '-').replace(/&/g, 'e');
}

const jsonLdBreadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://giolabriparazioni.it/' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://giolabriparazioni.it/blog' },
    { '@type': 'ListItem', position: 3, name: category, item: `https://giolabriparazioni.it/blog/categoria/${categorySlug(category)}` },
  ],
};
---

<MainLayout
  title={`${category} | Blog Giolab Riparazioni`}
  description={`Articoli e guide nella categoria "${category}". Consigli dal tecnico di Giolab Assemini per la cura dei tuoi dispositivi.`}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdBreadcrumb)} />
  </Fragment>

  <!-- Hero -->
  <section class="bg-gradient-to-br from-giolab-blue to-giolab-blue-dark text-white">
    <div class="section-padding text-center">
      <nav class="text-sm text-blue-200 mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white">Home</a>
        <span class="mx-2">/</span>
        <a href="/blog" class="hover:text-white">Blog</a>
        <span class="mx-2">/</span>
        <span class="text-white">{category}</span>
      </nav>
      <h1 class="text-4xl md:text-5xl font-extrabold !text-white mb-4">{category}</h1>
      <p class="text-lg text-blue-100 max-w-2xl mx-auto">{posts.length} {posts.length === 1 ? 'articolo' : 'articoli'} in questa categoria.</p>
    </div>
  </section>

  <!-- Category Filter -->
  <section class="border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 py-4 flex gap-2 overflow-x-auto">
      <a href="/blog" class="px-4 py-2 rounded-full text-sm font-medium bg-gray-100 text-gray-600 hover:bg-gray-200 transition-colors whitespace-nowrap">Tutti</a>
      {categories.map(cat => (
        <a
          href={`/blog/categoria/${categorySlug(cat)}`}
          class:list={[
            'px-4 py-2 rounded-full text-sm font-medium whitespace-nowrap transition-colors',
            cat === category
              ? 'bg-giolab-blue text-white'
              : 'bg-gray-100 text-gray-600 hover:bg-gray-200',
          ]}
        >
          {cat}
        </a>
      ))}
    </div>
  </section>

  <!-- Posts Grid -->
  <section>
    <div class="section-padding">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {posts.map(post => (
          <article class="card group hover:-translate-y-1 transition-transform duration-300 flex flex-col">
            <div class="bg-giolab-gray rounded-lg h-48 flex items-center justify-center mb-4 overflow-hidden">
              <svg class="w-12 h-12 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            </div>
            <div class="flex items-center gap-3 mb-3">
              <span class="text-xs font-semibold bg-blue-50 text-giolab-blue px-3 py-1 rounded-full">{post.data.category}</span>
              {post.data.readingTime && (
                <span class="text-xs text-gray-500">{post.data.readingTime}</span>
              )}
            </div>
            <h2 class="text-lg font-bold mb-2 group-hover:text-giolab-blue transition-colors">
              <a href={`/blog/${post.id}`} class="hover:underline">{post.data.title}</a>
            </h2>
            <p class="text-sm text-gray-600 mb-4 flex-1">{post.data.description}</p>
            <div class="flex items-center justify-between text-xs text-gray-500">
              <time datetime={post.data.date.toISOString()}>
                {post.data.date.toLocaleDateString('it-IT', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
              <a href={`/blog/${post.id}`} class="text-giolab-blue font-semibold hover:underline">Leggi &rarr;</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</MainLayout>
