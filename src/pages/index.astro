---
import MainLayout from '@/layouts/MainLayout.astro';

const services = [
  { icon: '📱', title: 'Riparazione Smartphone', desc: 'iPhone, Samsung, Huawei e tutti i brand. Sostituzione schermo, batteria, connettore di ricarica e altro.' },
  { icon: '📟', title: 'Riparazione Tablet', desc: 'iPad, Samsung Galaxy Tab e tablet di ogni marca. Interventi rapidi e garantiti.' },
  { icon: '💻', title: 'Riparazione PC & Mac', desc: 'Notebook e desktop. Formattazione, upgrade SSD/RAM, riparazione hardware e software.' },
  { icon: '🎮', title: 'Riparazione Console', desc: 'PlayStation, Xbox, Nintendo Switch. Pulizia, sostituzione componenti e aggiornamenti.' },
  { icon: '🔋', title: 'Sostituzione Batteria', desc: 'Batterie originali e certificate per tutti i dispositivi. Intervento in giornata.' },
  { icon: '🛡️', title: 'Pellicole & Cover', desc: 'Protezioni in vetro temperato, pellicole idrogel e cover di qualità per il tuo device.' },
];

const testimonials = [
  { name: 'Marco R.', text: 'Servizio eccellente! Schermo iPhone riparato in meno di un\'ora. Professionalità e cortesia al top.', rating: 5 },
  { name: 'Sara M.', text: 'Ho portato il mio MacBook con problemi alla scheda madre. Risolto in 2 giorni e a un prezzo onesto.', rating: 5 },
  { name: 'Luca P.', text: 'La mia PS5 non leggeva i dischi. Riparata perfettamente. Consiglio Giolab a tutti!', rating: 5 },
  { name: 'Anna G.', text: 'Batteria Samsung sostituita in 30 minuti. Velocissimi e molto gentili. Tornerò sicuramente!', rating: 5 },
];

const faqs = [
  { q: 'Quanto tempo ci vuole per una riparazione?', a: 'La maggior parte delle riparazioni viene completata in giornata. Per interventi più complessi, come riparazioni su scheda madre, possono servire 2-3 giorni lavorativi.' },
  { q: 'Offrite garanzia sulle riparazioni?', a: 'Sì, tutte le nostre riparazioni sono coperte da garanzia. La durata varia da 3 a 12 mesi a seconda del tipo di intervento.' },
  { q: 'Utilizzate ricambi originali?', a: 'Utilizziamo ricambi originali o di qualità equivalente certificata, sempre garantendo le massime prestazioni del dispositivo.' },
  { q: 'È necessario prendere appuntamento?', a: 'No, puoi venire direttamente nel nostro laboratorio durante gli orari di apertura. Per interventi complessi, ti consigliamo di contattarci prima su WhatsApp.' },
  { q: 'Fate preventivi gratuiti?', a: 'Sì, la diagnosi e il preventivo sono sempre gratuiti e senza impegno. Contattaci su WhatsApp o vieni in negozio.' },
  { q: 'Dove si trova il laboratorio?', a: 'Siamo in Via Carmine 20, 09032 Assemini (CA). Facilmente raggiungibile da Cagliari e da tutta l\'area metropolitana.' },
];

const jsonLdLocalBusiness = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': 'https://giolabriparazioni.it/#business',
  name: 'Giolab Riparazioni',
  description: 'Centro riparazioni specializzato in smartphone, tablet, PC e console ad Assemini.',
  url: 'https://giolabriparazioni.it',
  telephone: '+393406970686',
  email: 'Giolabassemini@gmail.com',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Via Carmine 20',
    addressLocality: 'Assemini',
    addressRegion: 'CA',
    postalCode: '09032',
    addressCountry: 'IT',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 39.2547,
    longitude: 9.0020,
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '10:00',
      closes: '12:30',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '16:00',
      closes: '19:00',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: 'Saturday',
      opens: '10:00',
      closes: '12:30',
    },
  ],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.9',
    bestRating: '5',
    ratingCount: '150',
  },
  priceRange: '€€',
  image: 'https://giolabriparazioni.it/og-default.jpg',
  sameAs: [
    'https://www.facebook.com/GioLabAssemini',
    'https://www.instagram.com/giolab_iphonefix/',
  ],
};

const jsonLdFaq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.a,
    },
  })),
};

const jsonLdBreadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://giolabriparazioni.it/' },
  ],
};
---

<MainLayout
  title="Giolab Riparazioni"
  description="Centro riparazioni smartphone, tablet, PC e console ad Assemini (CA). Riparazione iPhone, Samsung, Mac e PlayStation. Preventivi gratuiti, interventi rapidi e garantiti."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdLocalBusiness)} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdFaq)} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdBreadcrumb)} />
  </Fragment>

  <!-- Hero Section -->
  <section class="relative bg-gradient-to-br from-giolab-blue to-giolab-blue-dark text-white overflow-hidden">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute top-20 left-10 w-72 h-72 bg-white rounded-full blur-3xl"></div>
      <div class="absolute bottom-10 right-10 w-96 h-96 bg-giolab-orange rounded-full blur-3xl"></div>
    </div>
    <div class="relative section-padding text-center md:text-left md:flex md:items-center md:gap-12">
      <div class="flex-1">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold !text-white leading-tight mb-6">
          Riparazione Smartphone<br class="hidden md:block" /> e Dispositivi ad <span class="text-giolab-orange">Assemini</span>
        </h1>
        <p class="text-lg md:text-xl text-blue-100 mb-8 max-w-2xl">
          Giolab è il tuo centro di fiducia per riparazioni rapide e garantite di iPhone, Samsung, tablet, PC e console. Preventivi gratuiti e interventi in giornata.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center md:justify-start">
          <a href="/contatti" class="btn-primary text-lg">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
            Richiedi Preventivo
          </a>
          <a href="https://wa.me/393406970686" target="_blank" rel="noopener noreferrer" class="btn-whatsapp text-lg">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            Scrivici su WhatsApp
          </a>
        </div>
      </div>
      <div class="hidden lg:flex flex-1 justify-center mt-12 md:mt-0">
        <div class="w-72 h-72 bg-white/10 rounded-3xl backdrop-blur-sm flex items-center justify-center border border-white/20">
          <span class="text-8xl">🔧</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Section -->
  <section class="bg-giolab-gray" id="servizi">
    <div class="section-padding">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold mb-4">I Nostri Servizi</h2>
        <p class="text-gray-600 max-w-2xl mx-auto">Offriamo riparazioni professionali per tutti i tuoi dispositivi elettronici, con garanzia e ricambi certificati.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {services.map(service => (
          <div class="card text-center group hover:-translate-y-1 transition-transform duration-300">
            <div class="text-4xl mb-4">{service.icon}</div>
            <h3 class="text-lg font-bold mb-2 text-giolab-dark">{service.title}</h3>
            <p class="text-sm text-gray-600 leading-relaxed">{service.desc}</p>
          </div>
        ))}
      </div>
      <div class="text-center mt-10">
        <a href="/servizi" class="btn-secondary">Scopri tutti i servizi</a>
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section>
    <div class="section-padding">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold mb-4">Perché Scegliere Giolab</h2>
        <p class="text-gray-600 max-w-2xl mx-auto">La qualità e la trasparenza sono i pilastri del nostro lavoro.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {[
          { icon: '⚡', title: 'Rapidità', desc: 'La maggior parte delle riparazioni viene completata in giornata.' },
          { icon: '✅', title: 'Garanzia', desc: 'Ogni intervento è coperto da garanzia fino a 12 mesi.' },
          { icon: '💎', title: 'Qualità', desc: 'Ricambi originali o certificati di altissima qualità.' },
          { icon: '🤝', title: 'Trasparenza', desc: 'Preventivo gratuito e senza impegno. Nessun costo nascosto.' },
        ].map(item => (
          <div class="text-center">
            <div class="text-4xl mb-4">{item.icon}</div>
            <h3 class="text-lg font-bold mb-2">{item.title}</h3>
            <p class="text-sm text-gray-600">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="bg-giolab-gray">
    <div class="section-padding">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold mb-4">Cosa Dicono i Nostri Clienti</h2>
        <div class="flex items-center justify-center gap-2 text-giolab-orange">
          {Array.from({ length: 5 }).map(() => (
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
          ))}
          <span class="text-gray-600 font-semibold ml-2">4.9/5 su Google</span>
        </div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
        {testimonials.map(t => (
          <div class="card">
            <div class="flex items-center gap-1 text-giolab-orange mb-3">
              {Array.from({ length: t.rating }).map(() => (
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              ))}
            </div>
            <p class="text-gray-600 text-sm italic mb-4">"{t.text}"</p>
            <p class="font-semibold text-sm text-giolab-dark">{t.name}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq">
    <div class="section-padding">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold mb-4">Domande Frequenti</h2>
        <p class="text-gray-600 max-w-2xl mx-auto">Risposte alle domande più comuni sui nostri servizi di riparazione.</p>
      </div>
      <div class="max-w-3xl mx-auto space-y-4">
        {faqs.map(faq => (
          <details class="group bg-white border border-gray-200 rounded-xl overflow-hidden">
            <summary class="flex items-center justify-between p-5 cursor-pointer font-semibold text-giolab-dark hover:bg-gray-50 transition-colors">
              {faq.q}
              <svg class="w-5 h-5 text-gray-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-5 pb-5 text-sm text-gray-600 leading-relaxed">{faq.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="bg-gradient-to-r from-giolab-blue to-giolab-blue-dark text-white">
    <div class="section-padding text-center">
      <h2 class="text-3xl md:text-4xl font-bold !text-white mb-4">Hai bisogno di una riparazione?</h2>
      <p class="text-blue-100 text-lg mb-8 max-w-2xl mx-auto">Contattaci per un preventivo gratuito e senza impegno. Riparazioni rapide e garantite.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contatti" class="btn-primary text-lg">Richiedi Preventivo</a>
        <a href="https://wa.me/393406970686" target="_blank" rel="noopener noreferrer" class="btn-whatsapp text-lg">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          Scrivici su WhatsApp
        </a>
      </div>
    </div>
  </section>
</MainLayout>
