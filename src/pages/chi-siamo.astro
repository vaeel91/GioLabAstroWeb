---
import MainLayout from '@/layouts/MainLayout.astro';

const jsonLdBreadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://giolabriparazioni.it/' },
    { '@type': 'ListItem', position: 2, name: 'Chi Siamo', item: 'https://giolabriparazioni.it/chi-siamo' },
  ],
};

const milestones = [
  { year: '2015', title: 'Gli Inizi', desc: 'Stefano inizia a riparare dispositivi per passione, studiando elettronica e microsaldatura in autonomia.' },
  { year: '2018', title: 'Nasce Giolab', desc: 'La passione diventa professione. Apre il laboratorio ad Assemini, punto di riferimento per l\'area metropolitana di Cagliari.' },
  { year: '2020', title: 'Specializzazione', desc: 'Giolab si specializza nelle microsaldature e riparazioni di schede madri, risolvendo problemi che altri centri rifiutano.' },
  { year: '2024', title: 'Centro di Riferimento', desc: 'Con oltre 150 recensioni a 5 stelle su Google, Giolab è il tecnico di fiducia per Assemini, Decimomannu, Elmas, Uta e tutta la provincia di Cagliari.' },
];
---

<MainLayout
  title="Chi Siamo | Giolab Riparazioni Assemini"
  description="Scopri Giolab Riparazioni: laboratorio indipendente ad Assemini specializzato in riparazione smartphone, microsaldatura e assistenza PC. Fondato da Stefano Giordano."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdBreadcrumb)} />
  </Fragment>

  <!-- Hero -->
  <section class="bg-gradient-to-br from-giolab-blue to-giolab-blue-dark text-white">
    <div class="section-padding text-center">
      <nav class="text-sm text-blue-200 mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white">Home</a>
        <span class="mx-2">/</span>
        <span class="text-white">Chi Siamo</span>
      </nav>
      <h1 class="text-4xl md:text-5xl font-extrabold !text-white mb-4">Chi Siamo</h1>
      <p class="text-lg text-blue-100 max-w-2xl mx-auto">Un laboratorio indipendente dove competenza tecnica e rapporto diretto con il cliente fanno la differenza.</p>
    </div>
  </section>

  <!-- Story -->
  <section>
    <div class="section-padding">
      <div class="max-w-4xl mx-auto">
        <div class="flex flex-col md:flex-row gap-10 items-center mb-16">
          <div class="w-48 h-48 bg-giolab-gray rounded-full flex items-center justify-center flex-shrink-0">
            <svg class="w-24 h-24 text-giolab-blue/40" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
          </div>
          <div>
            <h2 class="text-2xl md:text-3xl font-bold mb-4">Stefano Giordano</h2>
            <p class="text-lg text-gray-500 font-medium mb-3">Fondatore & Tecnico Specializzato</p>
            <p class="text-gray-600 leading-relaxed mb-4">
              Ho iniziato smontando dispositivi per capire come funzionano. Quella curiosità si è trasformata in competenza tecnica: oggi risolvo anche i problemi più complessi, dalle microsaldature BGA alla diagnosi avanzata su scheda madre.
            </p>
            <p class="text-gray-600 leading-relaxed">
              In Giolab ogni dispositivo viene seguito dal tecnico dall'inizio alla fine. Niente passaggi di mano, niente sorprese. Il mio obiettivo è semplice: un servizio onesto, trasparente e di qualità a un prezzo giusto.
            </p>
          </div>
        </div>

        <!-- Philosophy -->
        <div class="bg-giolab-gray rounded-2xl p-8 md:p-12 mb-16">
          <h2 class="text-2xl md:text-3xl font-bold mb-8 text-center">Come Lavoriamo</h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <div class="text-center">
              <div class="inline-flex items-center justify-center w-14 h-14 bg-white rounded-xl text-giolab-blue mb-4 shadow-sm">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
              </div>
              <h3 class="font-bold text-lg mb-2">Diagnosi Accurata</h3>
              <p class="text-sm text-gray-600">Prima di toccare qualsiasi cosa, capiamo esattamente qual è il problema. Diagnosi gratuita, sempre.</p>
            </div>
            <div class="text-center">
              <div class="inline-flex items-center justify-center w-14 h-14 bg-white rounded-xl text-giolab-blue mb-4 shadow-sm">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
              </div>
              <h3 class="font-bold text-lg mb-2">Preventivo Chiaro</h3>
              <p class="text-sm text-gray-600">Ti comunichiamo il costo esatto prima di procedere. Se non conviene riparare, te lo diciamo.</p>
            </div>
            <div class="text-center">
              <div class="inline-flex items-center justify-center w-14 h-14 bg-white rounded-xl text-giolab-blue mb-4 shadow-sm">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
              </div>
              <h3 class="font-bold text-lg mb-2">Garanzia Reale</h3>
              <p class="text-sm text-gray-600">Ogni riparazione è coperta da garanzia fino a 12 mesi. Se c'è un problema, lo risolviamo.</p>
            </div>
          </div>
        </div>

        <!-- Timeline -->
        <h2 class="text-2xl md:text-3xl font-bold mb-10 text-center">La Nostra Storia</h2>
        <div class="relative">
          <div class="absolute left-4 md:left-1/2 top-0 bottom-0 w-0.5 bg-giolab-blue/20 -translate-x-1/2"></div>
          <div class="space-y-12">
            {milestones.map((m, i) => (
              <div class:list={['relative flex flex-col md:flex-row gap-4 md:gap-8', i % 2 !== 0 && 'md:flex-row-reverse']}>
                <div class="md:w-1/2 flex md:justify-end">
                  <div class:list={['bg-white border border-gray-200 rounded-xl p-6 max-w-md shadow-sm', i % 2 !== 0 ? 'md:mr-auto' : 'md:ml-auto']}>
                    <span class="inline-block bg-giolab-blue text-white text-sm font-bold px-3 py-1 rounded-full mb-3">{m.year}</span>
                    <h3 class="font-bold text-lg mb-2">{m.title}</h3>
                    <p class="text-sm text-gray-600">{m.desc}</p>
                  </div>
                </div>
                <div class="absolute left-4 md:left-1/2 w-4 h-4 bg-giolab-blue rounded-full -translate-x-1/2 mt-6 border-4 border-white"></div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-gradient-to-r from-giolab-blue to-giolab-blue-dark text-white">
    <div class="section-padding text-center">
      <h2 class="text-3xl md:text-4xl font-bold !text-white mb-4">Vieni a trovarci in laboratorio</h2>
      <p class="text-blue-100 text-lg mb-8">Via Carmine 20, 09032 Assemini (CA)</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contatti" class="btn-primary text-lg">Contattaci</a>
        <a href="https://wa.me/393406970686" target="_blank" rel="noopener noreferrer" class="btn-whatsapp text-lg">Scrivici su WhatsApp</a>
      </div>
    </div>
  </section>
</MainLayout>
