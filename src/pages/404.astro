---
import MainLayout from '@/layouts/MainLayout.astro';
---

<MainLayout
  title="Pagina non trovata"
  description="La pagina che stai cercando non esiste. Torna alla home di Giolab Riparazioni."
  noindex={true}
>
  <section class="section-padding min-h-[60vh] flex items-center justify-center">
    <div class="text-center">
      <div class="text-8xl mb-6">🔍</div>
      <h1 class="text-6xl md:text-8xl font-extrabold text-giolab-blue mb-4">404</h1>
      <h2 class="text-2xl md:text-3xl font-bold mb-4">Pagina Non Trovata</h2>
      <p class="text-gray-600 mb-8 max-w-md mx-auto">La pagina che stai cercando potrebbe essere stata spostata o non esiste più.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/" class="btn-secondary">Torna alla Home</a>
        <a href="/contatti" class="btn-primary">Contattaci</a>
      </div>
    </div>
  </section>
</MainLayout>
