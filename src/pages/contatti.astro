---
import MainLayout from '@/layouts/MainLayout.astro';

const jsonLdBreadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://giolabriparazioni.it/' },
    { '@type': 'ListItem', position: 2, name: 'Contatti', item: 'https://giolabriparazioni.it/contatti' },
  ],
};

const orari = [
  { giorno: 'Lunedì - Venerdì', orario: '10:00 - 12:30 / 16:00 - 19:00' },
  { giorno: 'Sabato', orario: '10:00 - 12:30' },
  { giorno: 'Domenica', orario: 'Chiuso' },
];
---

<MainLayout
  title="Contatti | Giolab Riparazioni Assemini"
  description="Contatta Giolab Riparazioni ad Assemini: preventivi gratuiti per riparazione smartphone, PC e console. WhatsApp, telefono o vieni in laboratorio in Via Carmine 20."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdBreadcrumb)} />
  </Fragment>

  <!-- Hero -->
  <section class="bg-gradient-to-br from-giolab-blue to-giolab-blue-dark text-white">
    <div class="section-padding text-center">
      <nav class="text-sm text-blue-200 mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white">Home</a>
        <span class="mx-2">/</span>
        <span class="text-white">Contatti</span>
      </nav>
      <h1 class="text-4xl md:text-5xl font-extrabold !text-white mb-4">Richiedi un Preventivo</h1>
      <p class="text-lg text-blue-100 max-w-2xl mx-auto">Compila il modulo con le informazioni sul tuo dispositivo. Verrai reindirizzato su WhatsApp per ricevere il preventivo direttamente.</p>
    </div>
  </section>

  <!-- Contact Content -->
  <section>
    <div class="section-padding">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 max-w-6xl mx-auto">
        <!-- WhatsApp Form -->
        <div>
          <h2 class="text-2xl font-bold mb-2">Descrivici il problema</h2>
          <p class="text-gray-500 text-sm mb-6">Compila i campi e clicca "Invia su WhatsApp". Si aprirà una chat con il messaggio già pronto.</p>

          <form id="whatsapp-form" class="space-y-5">
            <div>
              <label for="name" class="block text-sm font-medium text-gray-700 mb-1">Il tuo nome *</label>
              <input type="text" id="name" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-giolab-blue focus:border-transparent outline-none transition" placeholder="Nome e Cognome" />
            </div>

            <div>
              <label for="device" class="block text-sm font-medium text-gray-700 mb-1">Dispositivo *</label>
              <select id="device" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-giolab-blue focus:border-transparent outline-none transition bg-white">
                <option value="">Seleziona il tipo di dispositivo</option>
                <option value="iPhone">iPhone</option>
                <option value="Samsung">Samsung</option>
                <option value="Altro Smartphone">Altro Smartphone</option>
                <option value="iPad / Tablet">iPad / Tablet</option>
                <option value="PC / Notebook">PC / Notebook</option>
                <option value="Mac / MacBook">Mac / MacBook</option>
                <option value="PlayStation">PlayStation</option>
                <option value="Xbox">Xbox</option>
                <option value="Nintendo Switch">Nintendo Switch</option>
                <option value="Altro">Altro</option>
              </select>
            </div>

            <div>
              <label for="model" class="block text-sm font-medium text-gray-700 mb-1">Modello <span class="text-gray-400">(es. iPhone 14 Pro, Galaxy S24)</span></label>
              <input type="text" id="model" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-giolab-blue focus:border-transparent outline-none transition" placeholder="Indica il modello se lo conosci" />
            </div>

            <div>
              <label for="problem" class="block text-sm font-medium text-gray-700 mb-1">Descrizione del problema *</label>
              <textarea id="problem" required rows="4" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-giolab-blue focus:border-transparent outline-none transition resize-y" placeholder="Es. Lo schermo è rotto, non si accende, la batteria dura poco..."></textarea>
            </div>

            <button type="submit" class="btn-whatsapp w-full text-lg !py-4">
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              Invia su WhatsApp
            </button>
          </form>

          <p class="text-xs text-gray-400 mt-3">* Campi obbligatori. Cliccando il pulsante si aprirà WhatsApp con un messaggio precompilato. I tuoi dati non vengono salvati.</p>
        </div>

        <!-- Contact Info + Hours -->
        <div>
          <h2 class="text-2xl font-bold mb-6">Informazioni di Contatto</h2>

          <div class="space-y-6 mb-10">
            <!-- Address -->
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-blue-50 rounded-xl flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-giolab-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              </div>
              <div>
                <h3 class="font-semibold text-giolab-dark">Indirizzo</h3>
                <p class="text-gray-600">Via Carmine 20, 09032 Assemini (CA)</p>
              </div>
            </div>

            <!-- Phone -->
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-blue-50 rounded-xl flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-giolab-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              </div>
              <div>
                <h3 class="font-semibold text-giolab-dark">Telefono</h3>
                <a href="tel:+393406970686" class="text-giolab-blue hover:underline">340 697 0686</a>
              </div>
            </div>

            <!-- WhatsApp -->
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-green-50 rounded-xl flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-[#25D366]" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              </div>
              <div>
                <h3 class="font-semibold text-giolab-dark">WhatsApp</h3>
                <a href="https://wa.me/393406970686" target="_blank" rel="noopener noreferrer" class="text-[#25D366] hover:underline">Scrivici su WhatsApp</a>
              </div>
            </div>

            <!-- Email -->
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-blue-50 rounded-xl flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-giolab-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              </div>
              <div>
                <h3 class="font-semibold text-giolab-dark">Email</h3>
                <a href="mailto:Giolabassemini@gmail.com" class="text-giolab-blue hover:underline">Giolabassemini@gmail.com</a>
              </div>
            </div>
          </div>

          <!-- Opening Hours -->
          <h2 class="text-2xl font-bold mb-4">Orari di Apertura</h2>
          <div class="bg-giolab-gray rounded-xl p-6">
            <dl class="space-y-3">
              {orari.map(o => (
                <div class="flex justify-between items-center">
                  <dt class="font-medium text-giolab-dark">{o.giorno}</dt>
                  <dd class:list={['text-sm', o.orario === 'Chiuso' ? 'text-red-500 font-semibold' : 'text-gray-600']}>{o.orario}</dd>
                </div>
              ))}
            </dl>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Map -->
  <section class="bg-giolab-gray">
    <div class="section-padding">
      <h2 class="text-2xl md:text-3xl font-bold text-center mb-8">Dove Siamo</h2>
      <div class="rounded-2xl overflow-hidden shadow-lg max-w-5xl mx-auto">
        <iframe
          title="Mappa Giolab Riparazioni Assemini"
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3076.5!2d9.002!3d39.2547!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMznCsDE1JzE3LjAiTiA5wrAwMCcwNy4yIkU!5e0!3m2!1sit!2sit!4v1700000000000!5m2!1sit!2sit"
          width="100%"
          height="400"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </section>
</MainLayout>

<script>
  const form = document.getElementById('whatsapp-form') as HTMLFormElement;

  form?.addEventListener('submit', (e) => {
    e.preventDefault();

    const name = (document.getElementById('name') as HTMLInputElement).value.trim();
    const device = (document.getElementById('device') as HTMLSelectElement).value;
    const model = (document.getElementById('model') as HTMLInputElement).value.trim();
    const problem = (document.getElementById('problem') as HTMLTextAreaElement).value.trim();

    if (!name || !device || !problem) return;

    const lines = [
      `Ciao, sono *${name}* e vi contatto dal sito web.`,
      ``,
      `*Dispositivo:* ${device}${model ? ` - ${model}` : ''}`,
      `*Problema:* ${problem}`,
      ``,
      `Vorrei ricevere un preventivo. Grazie!`,
    ];

    const message = encodeURIComponent(lines.join('\n'));
    const url = `https://wa.me/393406970686?text=${message}`;

    window.open(url, '_blank');
  });
</script>
