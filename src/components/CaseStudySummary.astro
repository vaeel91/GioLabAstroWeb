---
interface Props {
  device?: string;
  fault?: string;
  difficulty?: 'Bassa' | 'Media' | 'Alta';
  repairTime?: string;
  components?: string[];
  tools?: string[];
  warranty?: string;
}

const { device, fault, difficulty, repairTime, components, tools, warranty } = Astro.props;

const difficultyConfig = {
  Bassa: { color: 'bg-green-100 text-green-800', dots: 1 },
  Media: { color: 'bg-yellow-100 text-yellow-800', dots: 2 },
  Alta: { color: 'bg-red-100 text-red-800', dots: 3 },
};

const hasData = device || fault || difficulty || repairTime || components?.length || tools?.length || warranty;
---

{hasData && (
  <aside class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm">
    <h3 class="text-lg font-bold text-giolab-dark mb-4 flex items-center gap-2">
      <svg class="w-5 h-5 text-giolab-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
      Scheda Intervento
    </h3>

    <dl class="space-y-3 text-sm">
      {device && (
        <div class="flex items-start gap-3">
          <dt class="font-semibold text-gray-500 w-28 flex-shrink-0">Dispositivo</dt>
          <dd class="text-giolab-dark font-medium">{device}</dd>
        </div>
      )}

      {fault && (
        <div class="flex items-start gap-3">
          <dt class="font-semibold text-gray-500 w-28 flex-shrink-0">Guasto</dt>
          <dd class="text-giolab-dark">{fault}</dd>
        </div>
      )}

      {difficulty && (
        <div class="flex items-start gap-3">
          <dt class="font-semibold text-gray-500 w-28 flex-shrink-0">Difficoltà</dt>
          <dd>
            <span class:list={['inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold', difficultyConfig[difficulty].color]}>
              {Array.from({ length: 3 }).map((_, i) => (
                <span class:list={['w-1.5 h-1.5 rounded-full', i < difficultyConfig[difficulty].dots ? 'bg-current' : 'bg-current opacity-20']} />
              ))}
              {difficulty}
            </span>
          </dd>
        </div>
      )}

      {repairTime && (
        <div class="flex items-start gap-3">
          <dt class="font-semibold text-gray-500 w-28 flex-shrink-0">Tempo</dt>
          <dd class="text-giolab-dark">{repairTime}</dd>
        </div>
      )}

      {warranty && (
        <div class="flex items-start gap-3">
          <dt class="font-semibold text-gray-500 w-28 flex-shrink-0">Garanzia</dt>
          <dd class="text-giolab-dark">{warranty}</dd>
        </div>
      )}
    </dl>

    {components && components.length > 0 && (
      <div class="mt-4 pt-4 border-t border-gray-100">
        <p class="font-semibold text-gray-500 text-sm mb-2">Componenti Sostituiti</p>
        <ul class="space-y-1.5">
          {components.map(c => (
            <li class="flex items-center gap-2 text-sm text-giolab-dark">
              <svg class="w-4 h-4 text-giolab-blue flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              {c}
            </li>
          ))}
        </ul>
      </div>
    )}

    {tools && tools.length > 0 && (
      <div class="mt-4 pt-4 border-t border-gray-100">
        <p class="font-semibold text-gray-500 text-sm mb-2">Strumentazione</p>
        <div class="flex flex-wrap gap-2">
          {tools.map(t => (
            <span class="inline-flex items-center gap-1 px-2.5 py-1 bg-gray-100 rounded-lg text-xs font-medium text-gray-700">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              {t}
            </span>
          ))}
        </div>
      </div>
    )}

    <div class="mt-5 pt-4 border-t border-gray-100">
      <a href="https://wa.me/393406970686?text=Ciao, ho un problema simile a quello descritto nell'articolo. Potreste aiutarmi?" target="_blank" rel="noopener noreferrer" class="btn-whatsapp w-full text-sm !py-2.5 justify-center">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        Richiedi riparazione simile
      </a>
    </div>
  </aside>
)}
